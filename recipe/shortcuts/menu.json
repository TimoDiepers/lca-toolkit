{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://schemas.conda.io/menuinst-1.schema.json",
  "menu_name": "LCA Toolkit",
  "menu_items": [
    {
      "name": "Activity Browser (LCA Toolkit)",
      "description": "Activity Browser 3 (beta) for Brightway 2.5",
      "command": ["{{ PREFIX }}/bin/activity-browser"],
      "activate": true,
      "terminal": false,
      "platforms": {
        "win": {
          "command": ["{{ PREFIX }}/Scripts/activity-browser.exe"],
          "desktop": true
        },
        "osx": {
          "activate": false,
          "command": [
            "bash", "-c",
            "eval \"$('{{ PREFIX }}/_conda' shell.bash activate '{{ PREFIX }}')\" && exec activity-browser"
          ],
          "CFBundleName": "Activity Browser LCA Toolkit",
          "CFBundleIdentifier": "io.github.lca-toolkit.activity-browser"
        }
      }
    },
    {
      "name": "JupyterLab (LCA Toolkit)",
      "description": "JupyterLab with Brightway 2.5, opens in the LCA-Notebooks folder in your home directory",
      "command": ["{{ PREFIX }}/bin/jupyter-lab"],
      "activate": true,
      "terminal": true,
      "platforms": {
        "win": {
          "command": [
            "cmd", "/c",
            "if not exist \"%USERPROFILE%\\LCA-Notebooks\" mkdir \"%USERPROFILE%\\LCA-Notebooks\" & \"{{ PREFIX }}\\Scripts\\jupyter-lab.exe\" --notebook-dir=\"%USERPROFILE%\\LCA-Notebooks\""
          ],
          "desktop": true
        },
        "osx": {
          "activate": false,
          "command": [
            "bash", "-c",
            "eval \"$('{{ PREFIX }}/_conda' shell.bash activate '{{ PREFIX }}')\" && mkdir -p \"$HOME/LCA-Notebooks\" && exec jupyter-lab --notebook-dir=\"$HOME/LCA-Notebooks\""
          ],
          "CFBundleName": "JupyterLab LCA Toolkit",
          "CFBundleIdentifier": "io.github.lca-toolkit.jupyterlab"
        }
      }
    }
  ]
}
