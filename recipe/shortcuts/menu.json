{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://schemas.conda.io/menuinst-1.schema.json",
  "menu_name": "LCA Toolkit",
  "menu_items": [
    {
      "name": "LCA Browser",
      "description": "Activity Browser 3 (beta) for Brightway 2.5",
      "icon": "{{ MENU_DIR }}/lca-browser.{{ ICON_EXT }}",
      "command": [
        "{{ PREFIX }}/bin/activity-browser"
      ],
      "activate": true,
      "terminal": false,
      "platforms": {
        "win": {
          "command": [
            "{{ PREFIX }}/Scripts/activity-browser.exe"
          ],
          "desktop": true
        },
        "osx": {
          "activate": false,
          "command": [
            "bash",
            "-c",
            "eval \"$('{{ PREFIX }}/_conda' shell.bash activate '{{ PREFIX }}')\" && exec activity-browser"
          ],
          "CFBundleName": "LCA Browser",
          "CFBundleIdentifier": "io.github.lca-toolkit.activity-browser"
        }
      }
    },
    {
      "name": "LCA Notebooks",
      "description": "JupyterLab with Brightway 2.5; opens in the teaching material folder, or LCA-Notebooks in your home folder",
      "icon": "{{ MENU_DIR }}/lca-notebooks.{{ ICON_EXT }}",
      "command": [
        "{{ PYTHON }}",
        "{{ PREFIX }}/share/lca-toolkit/launcher.py",
        "lab"
      ],
      "activate": true,
      "terminal": true,
      "platforms": {
        "win": {
          "command": [
            "{{ PYTHON }}",
            "{{ PREFIX }}/share/lca-toolkit/launcher.py",
            "lab"
          ],
          "desktop": true
        },
        "osx": {
          "activate": false,
          "command": [
            "bash",
            "-c",
            "eval \"$('{{ PREFIX }}/_conda' shell.bash activate '{{ PREFIX }}')\" && exec python '{{ PREFIX }}/share/lca-toolkit/launcher.py' lab"
          ],
          "CFBundleName": "LCA Notebooks",
          "CFBundleIdentifier": "io.github.lca-toolkit.jupyterlab"
        }
      }
    }
  ]
}
